From: Forgen <dev@forgen.local>
Subject: [PATCH 07/10] WebRTC leak protection.

Forces WebRTC to use only the default (proxy-affected) network interface and
disables mDNS host candidates, which otherwise leak the real local IP even
when the HTTP proxy is applied. The default routing policy matches what
Firefox's media.peerconnection.ice.default_address_only does.

---
 content/browser/renderer_host/render_process_host_impl.cc | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -150,6 +150,7 @@
 #include "content/public/common/result_codes.h"
 #include "content/public/common/webplugininfo.h"
 #include "media/webrtc/webrtc_switches.h"
+#include "forgen/forgen_config.h"

 namespace content {

@@ -420,6 +421,11 @@ void RenderProcessHostImpl::AppendRendererCommandLine(
     command_line->AppendSwitch("disable-mdns-names-for-ice-candidates");
     command_line->AppendSwitchASCII(
         "force-webrtc-ip-handling-policy", "default_public_interface_only");
   }
+  if (forgen::ForgenConfig::IsActive()) {
+    command_line->AppendSwitch("disable-mdns-names-for-ice-candidates");
+    command_line->AppendSwitchASCII(
+        "force-webrtc-ip-handling-policy", "default_public_interface_only");
+  }
 }
