From: Forgen <dev@forgen.local>
Subject: [PATCH 09/10] getBoundingClientRect / getClientRects sub-pixel jitter.

Adds per-profile sub-pixel jitter to Element rect readbacks when clientRects
mode is `noise`. The delta is ≪ 0.001 px so rendering is unaffected but
values hashed for fingerprinting diverge between profiles.

---
 third_party/blink/renderer/core/dom/element.cc | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/third_party/blink/renderer/core/dom/element.cc b/third_party/blink/renderer/core/dom/element.cc
--- a/third_party/blink/renderer/core/dom/element.cc
+++ b/third_party/blink/renderer/core/dom/element.cc
@@ -200,10 +200,24 @@
 #include "third_party/blink/renderer/core/layout/layout_box.h"
 #include "third_party/blink/renderer/core/style/computed_style.h"

+#include "forgen/forgen_config.h"
+
 namespace blink {

+namespace {
+float ForgenJitter(uint32_t& state) {
+  state = state * 1664525u + 1013904223u;
+  return (static_cast<int32_t>(state) / 2147483647.0f) * 0.0001f;
+}
+}  // namespace
+
 DOMRect* Element::getBoundingClientRect() {
   gfx::RectF rect = GetBoundingClientRectNoLifecycleUpdate();
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.client_rects == forgen::FpMode::kNoise) {
+      uint32_t s = static_cast<uint32_t>(fp.noise_seed);
+      rect.Offset(ForgenJitter(s), ForgenJitter(s));
+    }
+  }
   return DOMRect::FromRectF(rect);
 }
