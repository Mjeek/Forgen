From: Forgen <dev@forgen.local>
Subject: [PATCH 05/10] Per-profile seeded canvas noise.

Applies a deterministic, seeded ±1 noise to each pixel's R channel when the
page reads the canvas back via getImageData / toDataURL / toBlob. Seed is
derived from profile_id (see ForgenFingerprint::noise_seed) so repeated reads
of the same canvas return the same result within a profile, but different
profiles fingerprint differently.

We noise *R* only because it's the channel most detectors hash, and
modifying only R keeps the visible image visually identical (humans don't
perceive a ±1 in a single channel).

---
 third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
--- a/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
+++ b/third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.cc
@@ -12,10 +12,27 @@
 #include "third_party/blink/renderer/core/imagebitmap/image_bitmap.h"
 #include "third_party/blink/renderer/core/typed_arrays/dom_array_buffer.h"

+#include "forgen/forgen_config.h"
+
 namespace blink {

+namespace {
+// Seeded LCG. Cheap, deterministic, good enough for 1-bit-per-pixel noise.
+uint32_t LcgNext(uint32_t& state) {
+  state = state * 1664525u + 1013904223u;
+  return state;
+}
+void ApplyForgenCanvasNoise(uint8_t* data, size_t len) {
+  if (!forgen::ForgenConfig::IsActive()) return;
+  const auto& fp = forgen::ForgenConfig::Get();
+  if (fp.canvas != forgen::FpMode::kNoise) return;
+  uint32_t state = static_cast<uint32_t>(fp.noise_seed);
+  for (size_t i = 0; i + 3 < len; i += 4) {
+    int8_t delta = static_cast<int8_t>((LcgNext(state) % 3)) - 1;
+    int v = static_cast<int>(data[i]) + delta;
+    data[i] = static_cast<uint8_t>(std::clamp(v, 0, 255));
+  }
+}
+}  // namespace
+
 ImageData* BaseRenderingContext2D::getImageData(...) {
   ImageData* result = GetImageDataInternal(...);
+  if (result) ApplyForgenCanvasNoise(result->data()->Data(), result->data()->lengthAsSizeT());
   return result;
 }
