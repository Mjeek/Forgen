From: Forgen <dev@forgen.local>
Subject: [PATCH 04/10] WebGL UNMASKED_VENDOR / RENDERER overrides.

Intercepts WebGLRenderingContextBase::getParameter for the two parameters
that detectors read via WEBGL_debug_renderer_info. When inactive, upstream
behaviour is preserved.

---
 third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
--- a/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
+++ b/third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.cc
@@ -22,10 +22,24 @@
 #include "gpu/GLES2/gl2extchromium.h"
 #include "gpu/command_buffer/client/gles2_interface.h"

+#include "forgen/forgen_config.h"
+
 namespace blink {

 ScriptValue WebGLRenderingContextBase::getParameter(
     ScriptState* script_state, GLenum pname) {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    // UNMASKED_VENDOR_WEBGL = 0x9245, UNMASKED_RENDERER_WEBGL = 0x9246.
+    if (pname == 0x9245 && !fp.vendor.empty()) {
+      return WebGLAny(script_state, String::FromUTF8(fp.vendor));
+    }
+    if (pname == 0x9246 && !fp.renderer.empty()) {
+      return WebGLAny(script_state, String::FromUTF8(fp.renderer));
+    }
+  }
+
   // (existing upstream switch on pname follows)
   switch (pname) {
     // ...
   }
 }
