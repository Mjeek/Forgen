From: Forgen <dev@forgen.local>
Subject: [PATCH 08/10] Timezone override via ICU.

Intercepts the default ICU TimeZone lookup Chromium uses so every renderer
observes the per-profile timezone, not the host system's. Intl.DateTimeFormat
and new Date() both consult this code path. Falls back to upstream if the
profile says "auto".

---
 base/i18n/icu_util.cc | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/base/i18n/icu_util.cc b/base/i18n/icu_util.cc
--- a/base/i18n/icu_util.cc
+++ b/base/i18n/icu_util.cc
@@ -13,6 +13,8 @@
 #include "third_party/icu/source/common/unicode/utypes.h"
 #include "third_party/icu/source/i18n/unicode/timezone.h"

+#include "forgen/forgen_config.h"
+
 namespace base {
 namespace i18n {

@@ -45,6 +47,19 @@ bool InitializeICU() {
   bool result = InitializeICUWithFileDescriptorInternal(...);
+  if (result && forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (!fp.timezone.empty() && fp.timezone != "auto") {
+      icu::UnicodeString tz_id;
+      tz_id.setTo(icu::UnicodeString::fromUTF8(fp.timezone));
+      std::unique_ptr<icu::TimeZone> zone(icu::TimeZone::createTimeZone(tz_id));
+      if (zone && *zone != icu::TimeZone::getUnknown()) {
+        icu::TimeZone::adoptDefault(zone.release());
+      }
+    }
+  }
+
   return result;
 }
 }  // namespace i18n
 }  // namespace base
