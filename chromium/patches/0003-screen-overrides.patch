From: Forgen <dev@forgen.local>
Subject: [PATCH 03/10] Screen dimension overrides.

Screen.{width,height,availWidth,availHeight} consult ForgenConfig. availHeight
subtracts a platform-plausible taskbar height (40 on Windows) so readers
don't see availHeight == height which is itself fingerprintable.

---
 third_party/blink/renderer/core/frame/screen.cc | 26 ++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/third_party/blink/renderer/core/frame/screen.cc b/third_party/blink/renderer/core/frame/screen.cc
--- a/third_party/blink/renderer/core/frame/screen.cc
+++ b/third_party/blink/renderer/core/frame/screen.cc
@@ -8,11 +8,35 @@
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/page/page.h"

+#include "forgen/forgen_config.h"
+
 namespace blink {

 int Screen::width() const {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.screen_width > 0) return fp.screen_width;
+  }
   return GetRect().width();
 }

 int Screen::height() const {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.screen_height > 0) return fp.screen_height;
+  }
   return GetRect().height();
 }

+int Screen::availWidth() const {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.screen_width > 0) return fp.screen_width;
+  }
+  return GetAvailableRect().width();
+}
+
+int Screen::availHeight() const {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.screen_height > 0) return fp.screen_height - 40;  // taskbar
+  }
+  return GetAvailableRect().height();
+}
+
 }  // namespace blink
