From: Forgen <dev@forgen.local>
Subject: [PATCH 02/10] Navigator fingerprint overrides.

Overrides userAgent, platform, hardwareConcurrency, deviceMemory, languages,
and hides webdriver at the C++ level in Blink. If ForgenConfig::IsActive()
is false (no --forgen-profile), behaviour is identical to upstream.

---
 third_party/blink/renderer/core/frame/navigator.cc | 40 ++++++++++++++++-
 1 file changed, 39 insertions(+), 1 deletion(-)

diff --git a/third_party/blink/renderer/core/frame/navigator.cc b/third_party/blink/renderer/core/frame/navigator.cc
--- a/third_party/blink/renderer/core/frame/navigator.cc
+++ b/third_party/blink/renderer/core/frame/navigator.cc
@@ -12,6 +12,8 @@
 #include "third_party/blink/renderer/platform/language.h"
 #include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"

+#include "forgen/forgen_config.h"
+
 namespace blink {

 String Navigator::userAgent() const {
@@ -19,6 +21,10 @@ String Navigator::userAgent() const {
   if (!frame || !frame->GetDocument())
     return String();
   probe::ApplyUserAgentOverride(...);
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (!fp.user_agent.empty()) return String::FromUTF8(fp.user_agent);
+  }
   return frame->Loader().UserAgent();
 }

@@ -30,18 +36,50 @@ String Navigator::platform() const {
   // (existing upstream implementation follows)
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (!fp.platform.empty()) return String::FromUTF8(fp.platform);
+  }
   return NavigatorID::platform();
 }

 unsigned Navigator::hardwareConcurrency() const {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.cpu_cores > 0) return static_cast<unsigned>(fp.cpu_cores);
+  }
   return base::SysInfo::NumberOfProcessors();
 }

 float Navigator::deviceMemory() const {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (fp.memory_gb > 0) return static_cast<float>(fp.memory_gb);
+  }
   return ApproximatedDeviceMemory::GetApproximatedDeviceMemory();
 }

 Vector<String> Navigator::languages() {
+  if (forgen::ForgenConfig::IsActive()) {
+    const auto& fp = forgen::ForgenConfig::Get();
+    if (!fp.language.empty() && fp.language != "auto") {
+      Vector<String> out;
+      out.push_back(String::FromUTF8(fp.language));
+      return out;
+    }
+  }
   return NavigatorLanguage::languages();
 }

+bool Navigator::webdriver() const {
+  // Always false when ForgenConfig is active — mirrors the behaviour of the
+  // JS-layer override so automation flags don't leak.
+  if (forgen::ForgenConfig::IsActive()) return false;
+  return NavigatorAutomationInformation::webdriver();
+}
+
 }  // namespace blink
