{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist/main",
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["electron/**/*", "backend/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "renderer"]
}
