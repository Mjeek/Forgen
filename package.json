{
  "name": "forgen",
  "version": "0.1.0",
  "description": "Forgen — anti-detect browser with patched Chromium, per-profile fingerprint isolation, proxy management.",
  "main": "dist/main/main.js",
  "author": "Forgen",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n renderer,main -c blue,magenta \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "package": "npm run build && electron-builder --win --x64",
    "chromium:fetch": "powershell -ExecutionPolicy Bypass -File chromium/scripts/fetch.ps1",
    "chromium:patch": "powershell -ExecutionPolicy Bypass -File chromium/scripts/apply-patches.ps1",
    "chromium:build": "powershell -ExecutionPolicy Bypass -File chromium/scripts/build.ps1"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.0",
    "lucide-react": "^0.445.0",
    "nanoid": "^5.0.7",
    "puppeteer-core": "^23.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "io.forgen.desktop",
    "productName": "Forgen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
